<pre class="r"><code>library(ggplot2)
library(plotly)
library(dplyr)
library(lubridate)

set.seed(2012)


## PART A: THE REAL TIMEWAVE ZERO MATH
 
h_vals &lt;- c(6,2,4,4,4,3,2,4,2,4,6,2,2,4,2,2,6,3,4,3,2,2,2,3,
            4,2,6,2,6,3,2,3,4,4,4,2,4,6,4,3,2,4,2,3,4,3,2,3,
            4,4,4,1,6,2,2,3,4,3,2,1,6,3,6,3)
 
mod_64 &lt;- function(i) {
  i &lt;- i %% 64
  i[i &lt; 0] &lt;- i[i &lt; 0] + 64
  i
}
h_at &lt;- function(i) {
  idx &lt;- mod_64(i)
  ifelse(idx == 0, h_vals[64], h_vals[idx])
}
exp_minus_one &lt;- function(i) {
  i &lt;- abs(i)
  ifelse(i %% 2 == 1, -1, 1)
}
idiv &lt;- function(a, b) trunc(a / b)
 
build_datapoints &lt;- function() {
  w &lt;- integer(384)
  for (k in 0:383) {
    a_term &lt;- exp_minus_one(idiv(k - 1, 32)) *
      ( h_at(k - 1) - h_at(k - 2) + h_at(-k) - h_at(1 - k) ) +
      3 * ( exp_minus_one(idiv(k - 3, 96)) *
              ( h_at(idiv(k, 3) - 1) - h_at(idiv(k, 3) - 2) +
                  h_at(-1 * idiv(k, 3)) - h_at(1 - idiv(k, 3)) ) ) +
      6 * ( exp_minus_one(idiv(k - 6, 192)) *
              ( h_at(idiv(k, 6) - 1) - h_at(idiv(k, 6) - 2) +
                  h_at(-1 * idiv(k, 6)) - h_at(1 - idiv(k, 6)) ) )
 
    b_term &lt;- ( 9 - h_at(-k) - h_at(k - 1) ) +
      3 * ( 9 - h_at(-1 * idiv(k, 3)) - h_at(idiv(k, 3) - 1) ) +
      6 * ( 9 - h_at(-1 * idiv(k, 6)) - h_at(idiv(k, 6) - 1) )
 
    w[k + 1] &lt;- abs(a_term) + abs(b_term)
  }
  w
}
 
w_data &lt;- build_datapoints()
 
w_fn &lt;- function(i) {
  idx &lt;- (i %% 384)
  idx[idx &lt; 0] &lt;- idx[idx &lt; 0] + 384
  w_data[idx + 1]
}
v_fn &lt;- function(x) {
  ix &lt;- floor(x)
  frac &lt;- x - ix
  w_fn(ix) + frac * (w_fn(ix + 1) - w_fn(ix))
}
f_fn &lt;- function(x, a = 64, max_i = 12) {
  total &lt;- 0
  ai &lt;- 1
  for (i in 0:max_i) {
    total &lt;- total + v_fn(x * ai) / ai
    ai &lt;- ai * a
  }
  aj &lt;- a
  j &lt;- 1
  while (TRUE) {
    arg &lt;- x / aj
    if (arg &lt; 3 || j &gt; 200) break
    total &lt;- total + v_fn(arg) * aj
    aj &lt;- aj * a
    j &lt;- j + 1
  }
  total
}
t_fn &lt;- function(x) f_fn(x) / 64^3   # x = days prior to the zero date
 
zero_date &lt;- as.POSIXct(&quot;2012-12-21 06:00:00&quot;, tz = &quot;UTC&quot;)
 
## ============================================================
## PART B: BUILD THE PRE-2012 SEGMENT FROM THE REAL WAVE
## ============================================================
 
## Rather than uniform yearly steps, sample DENSELY near the zero date
## and SPARSELY further in the past — this is necessary to actually see
## the wave&#39;s final approach to zero, since (per the paper&#39;s resonance
## proof) the wave&#39;s oscillations compress geometrically as x -&gt; 0.
## We do this with a cubic warp: u in [0,1] evenly spaced, but
## days_before = max_days * u^3 clusters points near u=0 (i.e. near the
## zero date) while thinning them out in the deep past.
 
max_days &lt;- as.numeric(difftime(zero_date, as.POSIXct(&quot;1990-01-01&quot;, tz = &quot;UTC&quot;), units = &quot;days&quot;))
n_pts    &lt;- 2000
u        &lt;- seq(0, 1, length.out = n_pts)
days_before_zero &lt;- max_days * u^3
days_before_zero &lt;- rev(days_before_zero)   # so it runs from far-past down to 0
 
dates_real &lt;- zero_date - ddays(days_before_zero)
years_real &lt;- decimal_date(dates_real)
 
novelty_real_raw &lt;- sapply(days_before_zero, t_fn)</code></pre>
