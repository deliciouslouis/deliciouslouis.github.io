<pre class="r"><code>## ============================================================
## PART C: FABRICATED POST-2012 &quot;CRASH&quot; (your original bit —
## kept as-is, this part is the joke, not the real theory)
## ============================================================
 
years_fake &lt;- seq(2012.2, 2026, by = 0.05)   # finer resolution so the loops read clearly
n_fake &lt;- length(years_fake)
t_since &lt;- years_fake - 2012
 
# A &quot;broken feedback loop&quot; instead of a clean crash:
# - an overall downward drift (the &quot;crash&quot; is still there)
# - several superimposed oscillations at different frequencies/phases,
#   whose amplitude GROWS with time (like a system oscillating out of control)
# - amplitude-modulated noise on top, also growing with time
drift        &lt;- 115 - 8 * t_since
loop_1       &lt;- 25 * sin(t_since * 2.3)
loop_2       &lt;- 15 * sin(t_since * 5.1 + 1.2) * (1 + 0.15 * t_since)
loop_3       &lt;- 8  * sin(t_since * 11.0 + 0.4)
growing_noise &lt;- rnorm(n_fake, 0, 1 + 0.6 * t_since)
 
novelty_fake_raw &lt;- drift + loop_1 + loop_2 + loop_3 + growing_noise
 
## ============================================================
## PART D: RESCALE onto one comparable axis
##
## The true t(x) has its own natural units (it spans from ~0 near
## the zero point up to very large values far in the past — it is
## NOT naturally on a 0-100 &quot;novelty index&quot; scale). To put it on
## the same chart as the fabricated post-2012 numbers, we rescale
## the real curve&#39;s *shape* (min-max normalized) onto roughly the
## same range as the fake curve. This preserves the true wave&#39;s
## structure faithfully; only the y-axis units are cosmetic.
## ============================================================
 
rescale_to &lt;- function(x, lo, hi) {
  (x - min(x)) / (max(x) - min(x)) * (hi - lo) + lo
}
 
novelty_real &lt;- rescale_to(novelty_real_raw, lo = 0, hi = 115)
 
matrix_data &lt;- bind_rows(
  data.frame(Year = years_real, Novelty = novelty_real,
             Timeline = &quot;Organic Chronology (real Timewave Zero)&quot;),
  data.frame(Year = years_fake, Novelty = novelty_fake_raw,
             Timeline = &quot;Synthetic Loop (fabricated)&quot;)
) %&gt;%
  mutate(Tooltip = paste0(&quot;Year: &quot;, floor(Year), &quot;&lt;br&gt;Novelty Index: &quot;, round(Novelty, 2)))
 
