## the same chart as the fabricated post-2012 numbers, we rescale
## the real curve's *shape* (min-max normalized) onto roughly the
## same range as the fake curve. This preserves the true wave's
## structure faithfully; only the y-axis units are cosmetic.
## ============================================================
rescale_to <- function(x, lo, hi) {
(x - min(x)) / (max(x) - min(x)) * (hi - lo) + lo
}
novelty_real <- rescale_to(novelty_real_raw, lo = 0, hi = 115)
matrix_data <- bind_rows(
data.frame(Year = years_real, Novelty = novelty_real,
Timeline = "Organic Chronology (real Timewave Zero)"),
data.frame(Year = years_fake, Novelty = novelty_fake_raw,
Timeline = "Synthetic Loop (fabricated)")
) %>%
mutate(Tooltip = paste0("Year: ", floor(Year), "<br>Novelty Index: ", round(Novelty, 2)))
# novelty years (or not so novel years...lol...)
anomaly_years <- c(1990.1, 1991.8, 1996.0, 1996.5, 1998.6, 1999.5, 2000.0, 2001.8, 2004.5, 2004.8, 2007.5, 2008.2, 2010.4, 2011.0, 2011.5, 2011.7, 2011.9, 2012.0, 2012.2, 2014.3, 2015.5, 2017.8, 2020.0, 2022.8, 2024.5, 2024.7, 2025.0, 2025.1, 2025.3, 2025.4, 2025.8, 2026.1, 2026.7)
anomaly_labels <- c(
"<b>[1990]</b><br>East and West Germany are reunified following the fall of the Berlin Wall.",
"<b>[1991]</b><br>The Soviet Union dissolves and the Cold War ends.",
"<b>[1996]</b><br>Scientists clone Dolly the sheep, the first mammal to be cloned from an adult cell.",
"<b>[1996]</b><br>The F.B.I. arrests Theodore Kaczynski, the Unabomber.",
"<b>[1998]</b><br>U.S. Embassies in Nairobi, Kenya and Dar es Salaam, Tanzania are bombed.",
"<b>[1999]</b><br>Ehud Barak wins election over Prime Minister Netanyahu after campaigning to move the peace process with Palestine forward.",
"<b>[2000]</b><br>Mass panic over societal collapse because of computers not being able to recognize the date changing: Y2K panic.",
"<b>[2001]</b><br>The Twin Towers are bombed, prompting the United States' War on Terror.",
"<b>[2004]</b><br>Indian Ocean Tsunami.",
"<b>[2004]</b><br>Hurricane Katrina.",
"<b>[2007]</b><br>The first iPhone is released.",
"<b>[2008]</b><br>The most severe global financial crisis since the Great Depression.",
"<b>[2010 FLASH CRASH: warning sign]</b><br> Futures trader Navinder Singh Sarao creates a massive automated sell order triggers a chain reaction among high-frequency trading algorithms causing the Dow Jones to plummet 1,000 points in minutes.",
"<b>[2011]</b><br>Egyptian President Hosni Mubarak is ousted after protests in Tunisia and Egypt.",
"<b>[2011]</b><br>9.0 magnitude earthquake hits Japan, causing the Fukushima Daiichi nuclear crisis.",
"<b>[2011]</b><br>Civil Wars break out in Libya and Syria.",
"<b>[2011]</b><br>Occupy Wallstreet movement.",
"<b>[2012 THRESHOLD]</b><br>Mayan Long Count calendar ends, Timewave Zero hits absolute zero and the novelty is unbearable, linear chronology is terminated.",
"<b>[2012 ALEXNET AI BREAKTHROUGH]</b><br>Starting point of the deep-learning revolution. The Board unleashing its ultimate control weapon to eliminate novelty.",
"<b>[2014]</b><br>Amazon Echo and Alexa are launched.",
"<b>[2015]</b><br>OpenAI is founded.",
"<b>[2017 FLASH CRASH]</b><br>A mysterious multimillion-dollar market sell order on the GDAX exchange triggers a massive domino effect of 800 automated stop-loss orders and margin liquidations, causing Ethereum to instantly go from $319 to $oo.1o.",
"<b>[2020]</b><br>COVID-19 pandemic.",
"<b>[2022]</b><br>OpenAI releases ChatGPT.",
"<b>[2024]</b><br>Popularization of AI-generated memes...full cultural takeover: Italian brainrot.",
"<b>[2024]</b><br>Rapid proliferation of AI companion and chat applications.",
"<b>[2025]</b><br>Albania appoints the first ever AI/virtual government minister.",
"<b>[2025]</b><br>1 in 3 teens report some emotional connection to AI.",
"<b>[2025]</b><br>College Board, known nonprofit which administers AP exams and the SAT, releases a survey stating that 84% of high school students claim to have used artificial intelligence for schoolwork.",
"<b>[2025]</b><br>Japanese woman Yurina Noguchi marries an AI chatbot that she has generated using ChatGPT.",
"<b>[2025]</b><br>President Trump returns to the White House, DOGE cuts.",
"<b>[2026]</b><br>Rumors circulate of political figures covering up their deaths with AI-generated media.",
"<b>[2026: NOW]</b><br>We are in a total purgatory of synthetic, looping novelty decline."
)
anomaly_df <- data.frame(Year = anomaly_years) %>%
mutate(
Year = pmax(pmin(Year, max(matrix_data$Year)), min(matrix_data$Year)),
Novelty = approx(matrix_data$Year, matrix_data$Novelty, xout = Year)$y,
Tooltip = paste0("<span style='color:darkslateblue;'>", anomaly_labels, "</span>")
)
# aesthetics
p <- ggplot(matrix_data, aes(x = Year, y = Novelty, color = Timeline, group = 1, text = Tooltip)) +
geom_line(linewidth = 0.9) +
geom_point(size = 1.1, alpha = 0.6) +
geom_point(data = anomaly_df, aes(x = Year, y = Novelty, text = Tooltip),
inherit.aes = FALSE, color = "darkslateblue", size = 3, shape = 18) +
geom_vline(xintercept = 2012.97, linetype = "dashed", color = "red", linewidth = 0.7) +
annotate("text", x = 2012.97, y = max(matrix_data$Novelty) * 1.02,
label = "ZERO POINT", color = "red", fontface = "bold", size = 3.5, hjust = 0.5) +
scale_color_manual(values = c("Organic Chronology (real Timewave Zero)" = "darkolivegreen",
"Synthetic Loop (fabricated)"             = "chartreuse2")) +
labs(
title    = "Novelty, 1990\u20132026",
subtitle = "Pre-2012: real Timewave Zero math. Post-2012: Mckenna's wave post-2012 was never defined, filled in here for effect.",
x = NULL, y = "Novelty Index (rescaled)",
color = "Timeline Regime"
) +
theme_minimal(base_size = 13) +
theme(
plot.title    = element_text(face = "bold"),
plot.subtitle = element_text(color = "grey40", size = 9),
legend.position = "bottom"
)
print(p)
p_ly <- ggplotly(p, tooltip = "text") %>%
layout(hovermode = "x unified", legend = list(orientation = "h", y = -0.25))
# Render the interactive version. In RStudio this opens in the Viewer pane;
# if run via Rscript from a terminal, it opens in your default browser.
print(p_ly)
