## The true t(x) has its own natural units (it spans from ~0 near
## the zero point up to very large values far in the past — it is
## NOT naturally on a 0-100 "novelty index" scale). To put it on
## the same chart as the fabricated post-2012 numbers, we rescale
## the real curve's *shape* (min-max normalized) onto roughly the
## same range as the fake curve. This preserves the true wave's
## structure faithfully; only the y-axis units are cosmetic.
## ============================================================
rescale_to <- function(x, lo, hi) {
(x - min(x)) / (max(x) - min(x)) * (hi - lo) + lo
}
novelty_real <- rescale_to(novelty_real_raw, lo = 0, hi = 115)
